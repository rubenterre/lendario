---
const ano = new Date().getFullYear();
import logo from "../assets/lendario_logo_dark_tagline_mini.webp";
import instagram from "../assets/socials/instagram_icon.webp";
import vimeo from "../assets/socials/vimeo_icon.webp";

---

<footer class="rodape">
  <div class="container rodape__inner">
    <!-- <p class="rodape__marca">Lendario</p> -->
     <img src={logo.src} alt="Logo de Lendario" class="rodape__logo" width="200" height="100">
    <p class="rodape__nota">
      Baralla tradicional inspirada na mitoloxía galega · Santiago de Compostela
    </p>
    <nav class="rodape__ligazons" aria-label="Enlaces del pie">
      <a href="#baraja">A baralla</a>
      <a href="#reserva">Reserva</a>
      <a href="/politica-de-privacidade">Política de privacidade</a>
      <a href="https://rubenterre.me" target="_blank">Contacto</a>
    </nav>
    <div class="rodape__sociais">
      <a href="https://www.instagram.com/lendario_naipes/" target="_blank" rel="noopener noreferrer">
      <img src={instagram.src} alt="Icono de Instagram" width="25" height="25">
      </a>
      <a href="https://vimeo.com/user263512063?fl=pp&fe=sh" target="_blank" rel="noopener noreferrer">
      <img src={vimeo.src} alt="Icono de Vimeo" width="25" height="25">
      </a>
    </div>
    <p class="rodape__copy">© {ano} Lendario. Tódolos dereitos reservados. Deseñado e desenvolto por <a href="https://rubenterre.me">Rubén Terré</a></p>
  </div>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--borde);
    background: var(--tinta-suave);
    padding-block: var(--space-12);
  }

  .rodape__inner { display: grid; gap: var(--space-3); text-align: center; }

  .rodape__logo{
    margin: 0 auto;
  }

  .rodape__marca {
    font-family: var(--fonte-display);
    font-size: 2rem;
    letter-spacing: 0.16em;
    color: var(--pergamino);
  }

  .rodape__nota, .rodape__copy { font-size: var(--text-xs); color: var(--texto-2); }

  .rodape__ligazons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-2);
  }

  .rodape__ligazons a {
    font-size: var(--text-sm);
    color: var(--texto-2);
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  .rodape__ligazons a:hover { color: var(--ouro-claro); }

  .rodape__sociais{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0px;
  }

  .rodape__sociais a{
    text-decoration: none;
  }
</style>
