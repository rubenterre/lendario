---
const ano = new Date().getFullYear();
import logo from "../assets/lendario_logo_dark_tagline_mini.webp";

---

<footer class="rodape">
  <div class="container rodape__inner">
    <!-- <p class="rodape__marca">Lendario</p> -->
     <img src={logo.src} alt="Logo de Lendario" class="rodape__logo" width="200" height="100">
    <p class="rodape__nota">
      Baralla tradicional inspirada na mitoloxía galega · Santiago de Compostela
    </p>
    <nav class="rodape__ligazons" aria-label="Enlaces del pie">
      <a href="#baraja">A baralla</a>
      <a href="#reserva">Reserva</a>
      <a href="/politica-de-privacidade">Política de privacidade</a>
      <a href="mailto:info@rubenterre.com">Contacto</a>
    </nav>
    <p class="rodape__copy">© {ano} Lendario. Tódolos dereitos reservados. Deseñado e desenvolto por <a href="https://rubenterre.me">Rubén Terré</a></p>
  </div>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--borde);
    background: var(--tinta-suave);
    padding-block: var(--space-12);
  }

  .rodape__inner { display: grid; gap: var(--space-3); text-align: center; }

  .rodape__logo{
    margin: 0 auto;
  }

  .rodape__marca {
    font-family: var(--fonte-display);
    font-size: 2rem;
    letter-spacing: 0.16em;
    color: var(--pergamino);
  }

  .rodape__nota, .rodape__copy { font-size: var(--text-xs); color: var(--texto-2); }

  .rodape__ligazons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-2);
  }

  .rodape__ligazons a {
    font-size: var(--text-sm);
    color: var(--texto-2);
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  .rodape__ligazons a:hover { color: var(--ouro-claro); }
</style>
