---
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container rodape__inner">
    <p class="rodape__marca">Lendario</p>
    <p class="rodape__nota">
      Baraja española inspirada en la mitología gallega · Santiago de Compostela
    </p>
    <nav class="rodape__ligazons" aria-label="Enlaces del pie">
      <a href="#baraja">La baraja</a>
      <a href="#reserva">Reserva</a>
      <a href="mailto:ola@lendario.gal">Contacto</a>
    </nav>
    <p class="rodape__copy">© {ano} Lendario. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--borde);
    background: var(--tinta-suave);
    padding-block: var(--space-12);
  }

  .rodape__inner { display: grid; gap: var(--space-3); text-align: center; }

  .rodape__marca {
    font-family: var(--fonte-display);
    font-size: 1.15rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ouro-claro);
  }

  .rodape__nota, .rodape__copy { font-size: var(--text-xs); color: var(--texto-2); }

  .rodape__ligazons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-2);
  }

  .rodape__ligazons a {
    font-size: var(--text-sm);
    color: var(--texto-2);
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  .rodape__ligazons a:hover { color: var(--ouro-claro); }
</style>
