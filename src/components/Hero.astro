---

const lanzamento = '30 de octubre de 2026';

import { getImage } from "astro:assets";
import backgroundHero from './src/assets/images/Hero-breogan-heroe.webp';

const optimizada = await getImage({ src: backgroundHero, format: 'webp' });
const backgroundStyle = `url('${optimizada.src}')`;
---

<section class="hero">

  <div class="container hero__inner">
    <p class="eyebrow">Baralla tradicional · Mitoloxía galega</p>
    <h1 class="hero__titulo">Lendario</h1>
    <p class="hero__claim">
      Cuarenta e oito cartas para invocar aos seres que habitan a néboa, o granito e os
      camiños de Galicia.
    </p>

    <div class="hero__data">
      <span class="hero__data-etiqueta">Lanzamento</span>
      <span class="hero__data-valor">{lanzamento}</span>
    </div>

    <div class="hero__acciones">
      <a class="btn btn--primario" href="#reserva">Reservar a baralla</a>
      <a class="btn btn--fantasma" href="#baraja">Ver as cartas</a>
    </div>
  </div>
</section>

<style define:vars={{ backgroundStyle }}>
.hero {
  position: relative;
  min-height: min(92svh, 900px);
  display: grid;
  align-items: center;
  justify-content: start;
  overflow: hidden;
  background: var(--backgroundStyle) center/cover no-repeat;
}

.hero__petroglifo {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(120vh, 1000px);
  aspect-ratio: 1;
  translate: -50% -50%;
  color: var(--ouro-claro);
  opacity: 0.13;
  animation: xirar 180s linear infinite;
}

@keyframes xirar {
  to {
    rotate: 360deg;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__petroglifo {
    animation: none;
  }
}

.hero__inner {
  position: relative;
  text-align: center;
  padding-block: var(--space-24) var(--space-16);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-6, 1.5rem);
}

.hero__titulo {
  font-size: var(--text-hero);
  letter-spacing: 0.02em;
  line-height: 1.1;
  text-wrap: balance;
  margin: 0;
  font-weight: 400;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: var(--text-sm, 0.875rem);
  color: var(--ouro-vello);
  background: var(--pergamino-alto);
  padding: 0.2em 0.6em;
  border-radius: 8px;
  -webkit-box-decoration-break: clone; /* Compatibilidad para Safari/Chrome */
  box-decoration-break: clone;
  font-weight: 700;
}

.hero__claim {
  max-width: 54ch;
  text-wrap: pretty;
  font-size: var(--text-lg, 1.25rem);
}

.hero__data {
  display: flex;
  flex-direction: column;
  gap: var(--space-1, 0.25rem);
  margin-block: var(--space-4);
}

.hero__data-etiqueta {
  font-size: var(--text-xs, 0.75rem);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  opacity: 0.8;
}

.hero__data-valor {
  font-weight: bold;
  font-size: var(--text-md, 1.1rem);
}

.hero__acciones {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-4, 1rem);
  margin-top: var(--space-4);
}

</style>
