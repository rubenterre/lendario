---

import Swiper from 'swiper';
import { EffectCards, Keyboard, A11y } from 'swiper/modules';

import { Image } from 'astro:assets';

import santaCompana from '../assets/images/02_comodin_santa_compana.webp';
import rainaLupa from '../assets/images/10_oros_lupa.webp';
import moura from '../assets/images/11_oros_moura.webp';
import urco from '../assets/images/12_copas_urco.webp';

const cartas = [
  {
    image: rainaLupa.src,
    nome: 'A Raíña Lupa',
    meta: 'Rei de ouros',
    descricion: 'Poderosa raíña vinculada á lenda do Pico Sacro.',
  },
  {
    image: santaCompana.src,
    nome: 'A Santa Compaña',
    meta: 'Comodín',
    descricion: 'Procesión de ánimas que percorre de noite os camiños con luces acesas.',
  },
  {
    image: moura.src,
    nome: 'A Moura',
    meta: 'Cabalo de ouros',
    descricion: 'Gardiá de tesouros en castros e mámoas, ligada ás fontes e ás pedras antigas.',
  },
  {
    image: urco.src,
    nome: 'O Urco',
    meta: 'Rei de copas',
    descricion: 'Can escuro que emerxe do mar e anuncia a morte co seu ouveo.',
  },
];
---

<section class="section baralla" id="baraja" aria-labelledby="baralla-titulo">
  <div class="container">
    <div class="baralla__intro reveal">
      <p class="eyebrow">O bestiario</p>

      <h2 class="baralla__titulo" id="baralla-titulo">
        Catro paus, un territorio encantado
      </h2>

      <p class="lead">
        Lendario mantén a estrutura da baralla española —oros, copas, espadas e bastos—,
        pero cada carta convértese nun ser do imaxinario galego, coa súa ilustración e unha
        ficha breve sobre a súa lenda. Serve para xogar á brisca ou ao tute e, de paso,
        descubrir quen anda polo monte cando cae a noite.
      </p>
    </div>

    <div class="bestiario-slider reveal">
      <div
        class="swiper bestiario-swiper"
        aria-label="Cartas de mostra da baralla Lendario"
      >
        <div class="swiper-wrapper">
          {
            cartas.map((carta) => (
              <article class="swiper-slide carta">
                <div class="carta__marco">
                  <div class="carta__arte">
                    <img
                      src={carta.image}
                      alt={`Ilustración de ${carta.nome}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="bestiario-slider__controles">
        <button
          class="bestiario-slider__boton bestiario-slider__anterior"
          type="button"
          aria-label="Ver a carta anterior"
        >
          <span aria-hidden="true">←</span>
        </button>

        <p class="bestiario-slider__axuda" aria-hidden="true">
          Desliza para descubrir as cartas
        </p>

        <button
          class="bestiario-slider__boton bestiario-slider__seguinte"
          type="button"
          aria-label="Ver a carta seguinte"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { EffectCards, Keyboard, A11y } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-cards';

  document.querySelectorAll('.bestiario-swiper').forEach((element) => {
    const previousButton = element
      .closest('.bestiario-slider')
      ?.querySelector('.bestiario-slider__anterior');

    const nextButton = element
      .closest('.bestiario-slider')
      ?.querySelector('.bestiario-slider__seguinte');

    const swiper = new Swiper(element, {
      modules: [EffectCards, Keyboard, A11y],
      effect: 'cards',
      loop: true,
      cardsEffect: {
        perSlideOffset: 11,
        perSlideRotate: 1.5,
        rotate: true,
        slideShadows: true,
      },
      slidesPerView: 1,
      grabCursor: true,
      speed: 650,
      threshold: 8,
      keyboard: {
        enabled: true,
        onlyInViewport: true,
      },
      a11y: {
        enabled: true,
      },
    });

    previousButton?.addEventListener('click', () => swiper.slidePrev());
    nextButton?.addEventListener('click', () => swiper.slideNext());
  });
</script>

<style>
  .baralla {
    background: linear-gradient(
      180deg,
      var(--tinta),
      var(--tinta-suave) 40%,
      var(--tinta)
    );
    border-top: 1px solid var(--borde);
  }

  .baralla__intro {
    
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-16));
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
  }

  .baralla__titulo {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
    text-wrap: balance;
    text-align: center;
  }

  .lead{
    text-align: center;
  }

  .cartas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(var(--space-4), 2.5vw, var(--space-8));
    margin: 0;
    padding: 0;
    list-style: none;
  }

    .bestiario-swiper {
    width: min(100%, 320px);
    overflow: visible;
  }

    .bestiario-swiper :global(.swiper-wrapper) {
    align-items: stretch;
  }

  .bestiario-swiper :global(.swiper-slide) {
    display: flex;
    height: auto;
    border-radius: 12px;
  }

  .carta {
    cursor: grab;
    user-select: none;
  }

  .carta:active {
    cursor: grabbing;
  }

  .bestiario-slider__controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .bestiario-slider__boton {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--borde);
    border-radius: 50%;
    color: var(--pergamino);
    background: color-mix(in oklab, var(--granito) 70%, var(--tinta));
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition:
      transform 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .bestiario-slider__boton:hover {
    transform: translateY(-2px);
    border-color: var(--ouro-claro);
    color: var(--ouro-claro);
    background: color-mix(in oklab, var(--musgo) 32%, var(--granito));
  }

  .bestiario-slider__boton:focus-visible {
    outline: 2px solid var(--ouro-claro);
    outline-offset: 4px;
  }

  .bestiario-slider__axuda {
    margin: 0;
    color: var(--texto-2);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-align: center;
  }

  @media (min-width: 720px) {
    .bestiario-swiper {
      width: 350px;
    }

    .bestiario-slider {
      gap: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta,
    .bestiario-slider__boton {
      transition: none;
    }
  }

  /* --- CARTA INTERFAZ 3D --- */
  .carta__marco {
    position: relative;
    height: 100%;
    perspective: 1000px; /* Perspectiva del entorno 3D */
  }

  .carta__cuerpo {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 25rem; /* Asegura altura suficiente para el contenido absoluto */
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .carta:hover .carta__cuerpo {
    transform: rotateY(180deg);
  }

  .carta__cara {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* --- CARA FRONT --- */
/*   .carta__cara--delante {
    background: color-mix(in oklab, var(--pergamino) 6%, transparent);
  } */

  .carta__arte {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  .carta__arte img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carta__pe {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-4) var(--space-4) var(--space-6);
  }

  .carta__meta {
    margin: 0;
    color: var(--ouro-claro);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .carta__nome {
    margin: 0.35rem 0 0.5rem;
    font-size: var(--text-lg);
  }

  .carta__desc {
    margin: 0;
    color: var(--texto-2);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* --- CARA BACK (REVERSO) --- */
  .carta__cara--trasera {
    background: linear-gradient(135deg, var(--tinta), var(--granito));
    color: var(--ouro-claro);
    transform: rotateY(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
    border-color: var(--ouro-claro);
  }

  .carta__reverso-contenido {
    font-family: serif;
    font-size: var(--text-lg);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Accesibilidad y Reducción de movimiento */
  @media (prefers-reduced-motion: reduce) {
    .carta__cuerpo {
      transition: none;
    }
    .carta:hover .carta__cuerpo {
      transform: none;
    }
  }
</style>
