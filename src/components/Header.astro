---
const enlaces = [
  { target: "_self", href: "#baraja", texto: "A baralla" },
  { target: "_self", href: "#reserva", texto: "Reserva" },
  { target: "_self", href: "#newsletter", texto: "Novidades" },
  {
    target: "_blank",
    href: "https://www.redbubble.com/es/shop/ap/183734601?ref=studio-promote",
    texto: "Tenda",
  },
];

import logo from "../assets/logo_lendario.webp";
---

<header class="cabeceira">
  <div class="container cabeceira__inner">
    <a class="marca" href="/" aria-label="Lendario · inicio">
      <img src={logo.src} alt="Logo de Lendario" width="70px" height="70px" />
      <span class="marca__texto">Lendario</span>
    </a>

    <nav class="nav" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={e.href} target={e.target}>
            {e.texto}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<header class="cabeceira-mobil">
  <div class="container cabeceira__inner-mobil">
    <a class="marca marca-mobil" href="/" aria-label="Lendario · inicio">
      <!--       <img src={logo.src} alt="Logo de Lendario" width="70px" height="70px"> 
 -->
      <span class="marca__texto">Lendario</span>
    </a>

    <nav class="nav nav-mobil" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={e.href} target={e.target}>
            {e.texto}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .cabeceira {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--tinta) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--borde);
  }

  .cabeceira-mobil {
    display: none;
  }

  .cabeceira__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 68px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--pergamino);
  }

  .marca__logo {
    width: 28px;
    height: 28px;
    color: var(--ouro-claro);
  }

  .marca__texto {
    font-family: var(--fonte-display);
    font-size: 2rem;
    /*  letter-spacing: 0.14em; */
  }

  .nav {
    display: flex;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
  }

  .nav a {
    font-size: var(--text-sm);
    color: var(--texto-2);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.25s var(--ease);
  }

  .nav a:hover {
    color: var(--ouro-claro);
  }

  @media (max-width: 560px) {
    .nav a:first-child {
      display: none;
    }
  }

  @media (max-width: 440px) {
    .cabeceira {
      display: none;
    }

    .cabeceira-mobil {
      display: flex;
      justify-items: center;
      align-items: center;
      flex-direction: column;
      height: fit-content;
    }

    .marca-mobil {
      display: flex;
      justify-content: center;
    }

    .nav-mobil {
      padding: 0.5rem 0px;
      display: flex;
      justify-content: center;
      gap: 2rem;
    }
  }
</style>
