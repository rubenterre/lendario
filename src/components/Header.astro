---
const enlaces = [
  { href: '#baraja', texto: 'La baraja' },
  { href: '#reserva', texto: 'Reserva' },
  { href: '#newsletter', texto: 'Novedades' },
];

import logo from './src/assets/logo_lendario.webp';

---

<header class="cabeceira">
  <div class="container cabeceira__inner">
    <a class="marca" href="/" aria-label="Lendario · inicio">
     <!--  <svg class="marca__logo" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="14.5" stroke="currentColor" stroke-width="1" opacity="0.45" />
        <path
          d="M16 5.5c5.8 0 10.5 4.7 10.5 10.5S21.8 26.5 16 26.5 5.5 21.8 5.5 16 9.6 7 14 7s7.5 3.3 7.5 7-2.7 6-6 6-5-2.2-5-5 1.8-4 4-4 3 1.3 3 2.8"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </svg> -->
      <img src={logo.src} alt="Logo de Lendario" width="70px" height="70px"> 
      <span class="marca__texto">Lendario</span>
    </a>

    <nav class="nav" aria-label="Principal">
      {enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
    </nav>
  </div>
</header>

<style>
  .cabeceira {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--tinta) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--borde);
  }

  .cabeceira__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 68px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--pergamino);
  }

  .marca__logo { width: 28px; height: 28px; color: var(--ouro-claro); }

  .marca__texto {
    font-family: var(--fonte-display);
    font-size: 1.25rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
  }

  .nav a {
    font-size: var(--text-sm);
    color: var(--texto-2);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.25s var(--ease);
  }

  .nav a:hover { color: var(--ouro-claro); }

  @media (max-width: 560px) {
    .nav a:first-child { display: none; }
  }
</style>
