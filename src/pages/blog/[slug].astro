---
// src/pages/blog/[slug].astro
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("gl-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<Layout title={`${post.data.title} | Lendario`} description={post.data.description}>
  <article class="post">
    <header class="post__header">
      <a class="post__back" href="/blog/">&larr; Volver á artigos</a>

      {post.data.tags.length > 0 && (
        <ul class="post__tags">
          {post.data.tags.map((tag) => (
            <li class="post__tag">{tag}</li>
          ))}
        </ul>
      )}

      <h1 class="post__title">{post.data.title}</h1>

      <p class="post__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <span class="post__updated">
            &middot; actualizado o {formatDate(post.data.updatedDate)}
          </span>
        )}
      </p>
    </header>

    {post.data.heroImage && (
      <div class="post__hero">
        <img
          src={post.data.heroImage.src}
          alt={post.data.heroAlt ?? post.data.title}
        />
      </div>
    )}

    <div class="post__content">
      <Content />
    </div>

    <footer class="post__footer">
      <a class="post__back" href="/blog/">&larr; Ver todas as lendas</a>
    </footer>
  </article>
</Layout>

<style>
  .post {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 2rem);
    color: #2c2a24;
  }

  .post__header {
    margin-bottom: 2rem;
  }

  .post__back {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: #8a6b2f;
    text-decoration: none;
  }

  .post__back:hover,
  .post__back:focus-visible {
    text-decoration: underline;
  }

  .post__tags {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post__tag {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(138, 107, 47, 0.12);
    color: #8a6b2f;
  }

  .post__title {
    margin: 0 0 0.5rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    line-height: 1.15;
    color: var(--pergamino);
  }

  .post__meta {
    margin: 0;
    font-size: 0.85rem;
    color: #5b5648;
  }

  .post__hero {
    margin: 0 0 2rem;
    border-radius: 0.25rem;
    overflow: hidden;
    background: #2c2a24;
  }

  .post__hero img {
    width: 100%;
    display: block;
  }

  .post__content {
    line-height: 1.75;
    font-size: 1.05rem;
    color: var(--pergamino);
  }

  .post__content :global(h2) {
    font-family: Georgia, "Times New Roman", serif;
    margin-top: 2.25rem;
    color: var(--pergamino-alto);
  }

  .post__content :global(p) {
    margin: 0 0 1.25rem;
    color: var(--pergamino);
  }

  .post__content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid #c4a45c;
    background: #f5ecd8;
     color: var(--pergamino);
    font-style: italic;
  }

  .post__footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(138, 107, 47, 0.25);
  }
</style>
