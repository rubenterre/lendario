---
// src/pages/blog/index.astro
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

import fondoHero from "../../assets/images/fondo_hero.avif";

const fondoHeroBg = `url("${fondoHero.src}")`

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("gl-ES", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);


---

<Layout
  title="Blog | Lendario"
  description="Historias, novidades, eventos e o proceso creativo detrás de Lendario, a baralla española inspirada na mitoloxía galega."
>
  <section class="hero">
    <div class="hero__inner">
      <h1 class="hero__title">Blog</h1>
      <p class="hero__subtitle">
        Novidades, eventos e o proceso creativo detrás de Lendario
      </p>
    </div>
  </section>

  <section class="blog">
    <div class="blog__header">
      <h2 class="blog__heading">Todos os artigos</h2>
      <span class="blog__count">{posts.length} artigo{posts.length !== 1 ? "s" : ""}</span>
    </div>
    <hr class="blog__divider" />

    {
      posts.length === 0 ? (
        <p class="blog__empty">Aínda non hai entradas publicadas. Volve pronto.</p>
      ) : (
        <ul class="blog__grid">
          {posts.map((post) => (
            <li class="blog-card">
              <a class="blog-card__link" href={`/blog/${post.id}/`}>
                <div class="blog-card__image-wrap">
                  {post.data.heroImage ? (
                    <Image
                      class="blog-card__image"
                      src={post.data.heroImage}
                      alt={post.data.heroAlt ?? post.data.title}
                      widths={[320, 640, 960]}
                      sizes="(min-width: 60rem) 22rem, 90vw"
                      loading="lazy"
                    />
                  ) : (
                    <div class="blog-card__image-fallback" aria-hidden="true" />
                  )}
                </div>
                <div class="blog-card__body">
                  <h3 class="blog-card__title">{post.data.title}</h3>
                  <time class="blog-card__date" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>

<style define:vars={{fondoHeroBg}}>
  .hero {
    position: relative;
    background: linear-gradient(160deg, #d9c9a3 0%, #c7b587 55%, #b8a476 100%);
    padding: clamp(3.5rem, 8vw, 6rem) 1.5rem clamp(4rem, 10vw, 7rem);
    text-align: center;
    background:     linear-gradient(
      360deg,
      rgba(7, 13, 18, 0.96) 0%,
      rgba(10, 21, 27, 0.90) 24%,
      rgba(18, 35, 37, 0.78) 46%,
      rgba(18, 35, 37, 0.65) 66%,
      rgba(18, 35, 37, 0.55) 100%
    )
  ,var(--fondoHeroBg);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .hero__inner {
    max-width: 40rem;
    margin: 0 auto;
  }

  .hero__title {
    display: inline-block;
    margin: 0 0 0.6rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    color: #dec1a1;
    border-bottom: 3px solid #8a3b46;
    padding-bottom: 0.35rem;
  }

  .hero__subtitle {
    margin: 0.75rem 0 0;
    font-size: 1.05rem;
    color: var(--pergamino);
  }

  .hero__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(3rem, 8vw, 6rem);
    display: block;
  }

  .blog {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem);
  }

  .blog__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .blog__heading {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    color: var(--ouro-claro);
  }

  .blog__count {
    font-size: 0.9rem;
    color: var(--ouro-vello);
  }

  .blog__divider {
    margin: 1rem 0 2.25rem;
    border: none;
    border-top: 1px solid rgba(138, 107, 47, 0.3);
  }

  .blog__empty {
    color: #5b5648;
  }

  .blog__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }

  .blog-card {
    background: var(--pergamino-alto);
    border: 1px solid rgba(138, 107, 47, 0.2);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(44, 42, 36, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .blog-card:hover,
  .blog-card:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(44, 42, 36, 0.12);
  }

  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .blog-card__image-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #2c2a24;
  }

  .blog-card__image,
  .blog-card__image-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-card__image-fallback {
    background: repeating-linear-gradient(
      135deg,
      #2c2a24,
      #2c2a24 10px,
      #34312a 10px,
      #34312a 20px
    );
  }

  .blog-card__body {
    padding: 1.1rem 1.25rem 1.35rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-card__title {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    line-height: 1.35;
    color: #2c2a24;
    flex: 1;
  }

  .blog-card__date {
    font-size: 0.85rem;
    color: #8a6b2f;
  }
</style>
