---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lendario · Baraja española de mitología gallega',
  description = 'Lendario es una baraja española ilustrada que recoge los seres míticos de Galicia. 48 cartas, cuatro palos y un bestiario de niebla y granito. Lanzamiento: 30 de octubre de 2026.',
} = Astro.props;

const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content="/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  </head>
  <body>
    <a class="saltar" href="#contido">Saltar al contenido</a>
    <Header />
    <main id="contido">
      <slot />
    </main>
    <Footer />

    <script>
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) {
              entrada.target.classList.add('is-visible');
              observador.unobserve(entrada.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observador.observe(el));
    </script>

    <style is:global>
      .saltar {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ouro-claro);
        color: var(--tinta);
        padding: 0.75rem 1.25rem;
        z-index: 200;
      }
      .saltar:focus { left: 1rem; top: 1rem; }
    </style>
  </body>
</html>
